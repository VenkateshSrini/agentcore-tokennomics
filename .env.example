# .env.example
# Copy this file to .env and fill in the values for local development.
#   cp .env.example .env
#
# In production (AgentCore Runtime) these are injected via deploy/agentcore.yaml
# environmentVariables -- do NOT commit a populated .env file.
#
# Variable source reference:
#   config.py            -- BEDROCK_MODEL_ID, TOKENOMICS_*, NAIE_DB_DSN,
#                           PERSISTENCE_BACKEND, JSON_DATA_DIR
#   app.py               -- AWS_REGION (also read by boto3 automatically),
#                           BEDROCK_MODEL_ID (via settings.bedrock_model_id)
#   deploy/Dockerfile    -- AGENT_OBSERVABILITY_ENABLED, OTEL_PYTHON_DISTRO,
#                           OTEL_PYTHON_CONFIGURATOR
#   boto3 / botocore     -- AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
#                           AWS_SESSION_TOKEN, AWS_REGION, AWS_DEFAULT_REGION
#   bedrock_agentcore/_utils/endpoints.py -- BEDROCK_AGENTCORE_DP_ENDPOINT,
#                           BEDROCK_AGENTCORE_CP_ENDPOINT

# =============================================================================
# AWS credentials  (local / Docker only -- in AgentCore the IAM role is used)
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Primary region -- read by config.py (settings.bedrock_region -> boto3 client),
# the bedrock-agentcore SDK, and boto3 itself automatically.
# Falls back to AWS_DEFAULT_REGION, then "us-east-1" in config.py.
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# =============================================================================
# Bedrock model  (config.py -- from_env() -> settings.bedrock_model_id)
# Used as the default modelId in app.py handler. Can be overridden per-request
# by passing "model_id" in the invocation payload.
# =============================================================================

# Full Bedrock model ID. See https://docs.aws.amazon.com/bedrock/latest/userguide/models-supported.html
# Common values:
#   anthropic.claude-3-haiku-20240307-v1:0    (fast, cheap)
#   anthropic.claude-3-5-sonnet-20241022-v2:0 (balanced)
#   anthropic.claude-3-opus-20240229-v1:0     (most capable)
#   amazon.nova-lite-v1:0
#   amazon.nova-pro-v1:0
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# =============================================================================
# Persistence backend  (config.py -- from_env())
# =============================================================================

# Which writer to use: "json" (local / test) or "postgresql" (production).
# Default: json
PERSISTENCE_BACKEND=json

# Required when PERSISTENCE_BACKEND=postgresql.
# Format: postgresql://user:password@host:5432/dbname
# Leave blank when using the json backend.
NAIE_DB_DSN=

# Output directory for JSON Lines files (used only when PERSISTENCE_BACKEND=json).
# Default: ./data
JSON_DATA_DIR=./data

# =============================================================================
# Tokenomics tagging  (config.py -- from_env())
# =============================================================================

# Application name written to every usage_event row. Required in production.
# Default: unset
TOKENOMICS_APP=my-agent-app

# Team name written to every usage_event row. Optional.
TOKENOMICS_TEAM=my-team

# =============================================================================
# Queue / flush tuning  (config.py -- from_env())
# Sane defaults are sufficient for most deployments; only change if needed.
# =============================================================================

# Number of usage events to accumulate before a batch write. Default: 100
TOKENOMICS_BATCH_SIZE=100

# Maximum seconds between flush cycles. Default: 2.0
TOKENOMICS_FLUSH_INTERVAL_S=2.0

# =============================================================================
# AgentCore observability  (deploy/Dockerfile ENV)
# Set these when deploying to AgentCore Runtime to enable the managed
# CloudWatch GenAI Observability dashboard [D-28].
# =============================================================================

# Enable the managed CloudWatch GenAI dashboard alongside this module.
AGENT_OBSERVABILITY_ENABLED=true

# Required pairing for AgentCore OTEL pipeline [D-28].
OTEL_PYTHON_DISTRO=aws_distro
OTEL_PYTHON_CONFIGURATOR=aws_configurator

# =============================================================================
# bedrock-agentcore SDK endpoint overrides  (bedrock_agentcore/_utils/endpoints.py)
# Leave blank in normal use; set only to point at a local stub or private endpoint.
# =============================================================================

# Data-plane endpoint override (optional).
BEDROCK_AGENTCORE_DP_ENDPOINT=

# Control-plane endpoint override (optional).
BEDROCK_AGENTCORE_CP_ENDPOINT=